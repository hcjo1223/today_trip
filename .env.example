# ============================================================================
# 오늘의여행 (Today's Trip) — Vercel + Supabase 환경 변수 템플릿
# Vercel 대시보드 -> Settings -> Environment Variables 에 아래 항목을 등록하세요.
# ============================================================================

# 1. Supabase 프로젝트 URL (Supabase Dashboard -> Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# 2. Supabase Anon Public Key (Supabase Dashboard -> Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# 3. (선택) Supabase Service Role Key — 서버 API 및 Cron Keep-Alive 쓰기 권한용
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
